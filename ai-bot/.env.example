# Server URLs (Docker)
SIGNALING_URL=ws://localhost:8083/ws/signaling
AUTH_URL=http://localhost:8081
ROOM_URL=http://localhost:8082

# Bot Account
BOT_EMAIL=ai-bot@webrtc.local
BOT_PASSWORD=bot123456
BOT_DISPLAY_NAME=AI Assistant

# Google Gemini (FREE - recommended!)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional - paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Ollama (local LLM - alternative to OpenAI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# TTS Settings (Vietnamese voice)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%

# Avatar
AVATAR_IMAGE=assets/avatar.png
